rules_version = '2';

// 링크피움 Firestore 보안 규칙
// - 모든 쓰기는 서버(Admin SDK)만 수행한다. 클라이언트 쓰기는 전부 거부.
// - 참여자는 로그인 없이 boards/{publicToken} 과 공개 게시물만 읽는다.
//   publicToken 은 128bit 무작위값이므로 경로를 아는 사람만 접근 가능하고, 목록 조회(list)는 막는다.
// - isReadable() 은 src/lib/shared.ts 의 isBoardReadable() 과 같은 로직을 유지할 것.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isReadable(b) {
      return b.status == 'live'
        || b.status == 'draft'
        || (b.status == 'ended' && b.readableAfterEnd == true);
    }

    // 강사 전용 강의 정보 (입장 코드 포함)
    match /sessions/{sessionId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    // 참여자 공개 보드
    match /boards/{token} {
      // 존재하지 않는 보드는 not_found 로 구분할 수 있도록 허용(내용 없음)
      allow get: if resource == null
        || isReadable(resource.data)
        || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow list: if false;
      allow write: if false;

      match /posts/{postId} {
        function board() {
          return get(/databases/$(database)/documents/boards/$(token)).data;
        }
        allow read: if (signedIn() && board().ownerId == request.auth.uid)
          || (resource.data.published == true && isReadable(board()));
        allow write: if false;
      }
    }

    // joinCodes, rateLimits 등 나머지는 서버 전용
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
