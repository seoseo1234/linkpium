# ── Firebase 웹앱 설정 (Firebase 콘솔 > 프로젝트 설정 > 내 앱 > SDK 설정) ──
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDPJjG_MNjDTZi5ZSVkuo5z2VNW6ix7OIM
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=linkpium.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=linkpium
NEXT_PUBLIC_FIREBASE_APP_ID=1:1099419760770:web:cf068780f35865ece01c9b

# ── 서버(Admin SDK) 서비스 계정 (프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성) ──
# JSON 파일 내용 중 세 값만 옮겨 넣습니다. private key 의 줄바꿈은 \n 으로 둡니다.
FIREBASE_PROJECT_ID=linkpium
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── 참여자용 공통 주소 (프로젝터 화면·직접 링크·QR 에 사용) ──
# 비워두면 현재 접속한 주소를 사용합니다. 예: https://linkpeum.vercel.app
NEXT_PUBLIC_SITE_URL=

# ── 코드 입장 시도 IP 해시용 비밀값 (아무 긴 무작위 문자열) ──
RATE_LIMIT_SALT=
